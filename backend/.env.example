# Rename this file to .env and fill in your own values

# Get this from MongoDB Atlas (see README.md for step-by-step guide)
MONGO_URI=your_mongodb_connection_string_here

# Any long random string, used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Port the backend server runs on
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Free API key from https://console.groq.com — powers priority detection,
# AI reply suggestions, and the AI chat assistant
GROQ_API_KEY=your_groq_api_key_here

# Optional — email notifications (agent reply alerts, new-agent invites).
# If left blank, the app still works fine — emails are just skipped and
# logged to the console instead. Using Gmail? See README.md for how to
# get an "App Password" (your normal Gmail password will NOT work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
